# Copy to .env (dev) or .env.prod (prod) and fill in. Never commit the real files.

# --- Django ---
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# Encrypts eWeLink/Shelly/camera credentials stored in the database.
# Generate: python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Losing this key makes stored credentials unreadable - back it up.
FIELD_ENCRYPTION_KEY=

# --- Database (used by the postgres container and Django) ---
POSTGRES_DB=vms
POSTGRES_USER=vms
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://vms:change-me@db:5432/vms

REDIS_URL=redis://redis:6379/0

# --- LiveKit Cloud (Phase 3) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Dev only: address the dev API binds to (127.0.0.1 or your Tailscale IP) ---
DEV_BIND=127.0.0.1
